{
  "name": "git-stack-manager",
  "displayName": "Git Stack Manager",
  "description": "Sapling ISL-style smartlog for plain Git: compact tree of your local branches/stacks, amend, checkout, restack.",
  "version": "0.12.0",
  "publisher": "krvukic",
  "author": "Kresimir Vukic",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1f22",
    "theme": "dark"
  },
  "keywords": [
    "git",
    "stack",
    "smartlog",
    "sapling",
    "rebase",
    "absorb",
    "stacked-diffs",
    "stacked-pull-requests",
    "scm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krvukic/git-stack-manager.git"
  },
  "bugs": {
    "url": "https://github.com/krvukic/git-stack-manager/issues"
  },
  "homepage": "https://github.com/krvukic/git-stack-manager#readme",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/hosts/extension.js",
  "imports": {
    "#core/*": "./out/core/*.js",
    "#git/*": "./out/git/*.js",
    "#history/*": "./out/history/*.js",
    "#github/*": "./out/github/*.js",
    "#ui/*": "./out/ui/*.js",
    "#app/*": "./out/app/*.js"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "gsm.open",
        "title": "Git Stack: Open Smartlog",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gsm.refresh",
        "title": "Git Stack: Refresh Local State",
        "icon": "$(refresh)"
      },
      {
        "command": "gsm.submitStack",
        "title": "Git Stack: Submit Stack (gh)",
        "icon": "$(git-pull-request)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gsm",
          "title": "Git Stack",
          "icon": "media/gsm.svg"
        }
      ]
    },
    "views": {
      "gsm": [
        {
          "id": "gsm.launcher",
          "name": "Smartlog"
        }
      ]
    },
    "menus": {
      "scm/title": [
        {
          "command": "gsm.open",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "gsm.open",
          "when": "view == gsm.launcher",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Git Stack Manager",
      "properties": {
        "gsm.trunk": {
          "type": "string",
          "default": "",
          "description": "Trunk ref (e.g. origin/main). Auto-detected when empty."
        },
        "gsm.submitCommand": {
          "type": "string",
          "default": "gh stack",
          "description": "Command run in a terminal by 'Submit Stack'. Uses your gh CLI stack extension."
        },
        "gsm.onlyMyCommits": {
          "type": "boolean",
          "default": false,
          "description": "Dim commits in the tree whose author email differs from git config user.email."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p . && bun run build:webview",
    "build:webview": "vite build",
    "watch": "tsc -w -p .",
    "watch:webview": "vite build --watch",
    "typecheck": "tsc -p . && tsc -p tsconfig.webview.json && tsc -p tsconfig.tooling.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,mts,tsx,mjs,css}\" \"*.{mjs,mts,js}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,mts,tsx,mjs,css}\" \"*.{mjs,mts,js}\"",
    "web": "node out/hosts/server.js",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "~1.106.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "10",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-odiff": "4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
